# InterviewAI environment. Copy to .env.local for local development and add the
# same variables in Vercel → Project → Settings → Environment Variables.

# --- Required -----------------------------------------------------------------

# MongoDB Atlas (free M0). In Atlas → Network Access, allow 0.0.0.0/0, because
# Vercel functions use dynamic IPs.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="interviewai"

# Groq (free): Whisper speech-to-text, plus the fallback interviewer LLM.
# https://console.groq.com/keys
GROQ_API_KEY=""

# NVIDIA API Catalog (free): primary interviewer, answer analysis and reports.
# https://build.nvidia.com  (optional if you are happy running on Groq only)
NVIDIA_API_KEY=""

# --- Optional tuning (defaults shown) ----------------------------------------

# Live interviewer: benchmarked fastest + strongest (p50 ~250 ms to first token, reasoning off).
# NVIDIA_REALTIME_MODEL="nvidia/nemotron-3-super-120b-a12b"
# A different model runs on an independent queue: used to hedge slow first tokens and for failover.
# NVIDIA_REALTIME_BACKUP_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# LLM_HEDGE_MS="800"               # start the backup request if no token arrives within this time
# NVIDIA_ANALYSIS_MODEL="nvidia/nemotron-3-super-120b-a12b"   # reports + canvas exercises
# NVIDIA's free tier allows ~40 requests/minute PER MODEL (measured), so per-answer
# background notes use a different model than the live interviewer.
# NVIDIA_NOTES_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# ANALYSIS_EVERY_N_ANSWERS="2"     # 1 = every answer, 0 = off
# NVIDIA_REALTIME_THINKING="false"
# NVIDIA_ANALYSIS_THINKING="true"
# NVIDIA_ANALYSIS_REASONING_BUDGET="1024"

# Groq chat is used when NVIDIA is missing or fails before answering.
# LLM_FALLBACK_GROQ="true"
# GROQ_REALTIME_MODEL="llama-3.3-70b-versatile"
# GROQ_ANALYSIS_MODEL="llama-3.3-70b-versatile"
# GROQ_STT_MODEL="whisper-large-v3-turbo"

# LLM_REALTIME_TIMEOUT="15"        # seconds without tokens before failing over
# LLM_ANALYSIS_TIMEOUT="45"
# LLM_REALTIME_MAX_TOKENS="512"
# LLM_ANALYSIS_MAX_TOKENS="2048"

# Microsoft Edge neural TTS (free, no key). Set TTS_ENABLED=false to use the
# browser's built-in speech synthesis instead.
# TTS_VOICE="en-US-AriaNeural"
# TTS_RATE="+0%"
# TTS_ENABLED="true"

# Abuse protection for a public deployment (per IP, per hour).
# MAX_TURNS_PER_SESSION="40"
# RATE_LIMIT_SESSIONS_PER_HOUR="12"
# RATE_LIMIT_UPLOADS_PER_HOUR="20"
# RATE_LIMIT_TURNS_PER_HOUR="240"
# RATE_LIMIT_REPORTS_PER_HOUR="30"
# RATE_LIMIT_TRANSCRIPTIONS_PER_HOUR="600"   # speculative STT calls (in-memory, per instance)

# Interviews, transcripts and reports are deleted automatically after N days.
# SESSION_RETENTION_DAYS="30"

# Canonical public URL for metadata (defaults to the Vercel deployment URL).
# NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Testing only: make interview time pass N times faster (e.g. 20) to exercise all
# sections quickly. Never set this in production.
# INTERVIEW_CLOCK_SPEEDUP="1"
